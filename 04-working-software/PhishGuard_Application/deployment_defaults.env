# Safe deployment starting values. Copy to your environment and replace placeholders.
# Live sending remains disabled until an Administrator completes SMTP verification.
BASE_URL=https://training.example.org
COOKIE_SECURE=true
ENABLE_SMTP=false

# Google Workspace / Gmail SMTP preset
SMTP_PROVIDER=google_workspace
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# Replace these placeholders before deployment
SENDER_NAME=Security Awareness Team
SENDER_EMAIL=security-training@example.org
ORGANIZATION_NAME=Example Organization
ALLOWED_RECIPIENT_DOMAINS=*
ALLOW_ALL_RECIPIENT_DOMAINS=true
FORCE_ALLOW_ALL_DOMAINS=false

# Persistent single-server dispatch defaults
BACKGROUND_DISPATCH_ENABLED=true
SYNCHRONOUS_DISPATCH=false
DISPATCH_RATE_PER_MINUTE=60
DEFAULT_TRAINING_DOMAIN=training.example.org
